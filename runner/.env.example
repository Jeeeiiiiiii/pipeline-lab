# Copy to .env (git-ignored) and fill in.
#
# REPO_URL      the GitHub repository the runner serves
# ACCESS_TOKEN  a fine-grained PAT with "Administration: read and write" on
#               that repository (the runner uses it to fetch a registration
#               token; it is not stored). Alternatively set RUNNER_TOKEN to
#               a registration token from Settings > Actions > Runners > New.
REPO_URL=https://github.com/<you>/pipeline-lab
ACCESS_TOKEN=github_pat_...
